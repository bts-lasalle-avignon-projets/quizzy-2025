QWidget {
    background-color: #fed102;
    padding: 20px;
}

QLabel {
    border: none;
    text-align: center;
    border-radius: 8px;
    font-size: 55px;
    background-color: none;
    color: #ffffff;
}

QWidget#ecranAttente {
border-image: url(:/images/ecran_attente.png);
}

QLabel#messageConnexion {
font-size: 75px;
background-color: none;
border: none;
font-family: 'REM';
margin-bottom: 375px;
}

QWidget#ecranAccueil {
border-image: url(:/images/ecran_accueil.png);
}

QLabel#messageThemeChoisi{
margin-top: 125px;
color: #000000;
}
